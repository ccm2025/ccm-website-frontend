{
	"name": "ccm-website-frontend",
	"main": ".svelte-kit/cloudflare/_worker.js",

	"compatibility_flags": ["nodejs_compat"],
	"compatibility_date": "2025-07-14",

	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},

	"observability": {
		"logs": {
			"enabled": true
		}
	}
}
